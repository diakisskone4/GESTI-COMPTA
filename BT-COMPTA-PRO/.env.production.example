# Copier en .env à la racine du projet sur le serveur, puis remplir chaque valeur.
DOMAIN=btcomptapro.example.ml
SECRET_KEY=generer-avec: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=btcomptapro.example.ml
CSRF_TRUSTED_ORIGINS=https://btcomptapro.example.ml
CORS_ALLOWED_ORIGINS=https://btcomptapro.example.ml,capacitor://localhost,http://localhost

DB_NAME=bt_compta_pro
DB_USER=btcompta
DB_PASSWORD=mot-de-passe-long-et-aleatoire

BACKUP_KEEP_DAYS=14
LOG_LEVEL=INFO

# Adresse publique du site (liens de réinitialisation du mot de passe)
FRONTEND_URL=https://btcomptapro.example.ml
# Adresse de l'administration Django : choisir un chemin difficile à deviner
ADMIN_URL=gestion-interne-7f3k/

# Envoi des e-mails (réinitialisation du mot de passe) — fournisseur SMTP
EMAIL_HOST=smtp.example.ml
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@btcomptapro.example.ml
EMAIL_HOST_PASSWORD=mot-de-passe-smtp
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=BT COMPTA PRO <no-reply@btcomptapro.example.ml>

# Sécurité de connexion
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Taille maximale des sujets / corrigés déposés (Mo)
MAX_UPLOAD_MB=10
