# Copier ce fichier en .env et adapter les valeurs.
DEBUG=True
SECRET_KEY=remplacer-par-une-cle-longue-et-aleatoire
ALLOWED_HOSTS=localhost,127.0.0.1
# postgresql (recommandé) ou sqlite (dépannage uniquement)
DB_ENGINE=postgresql
DB_NAME=bt_compta_pro
DB_USER=postgres
DB_PASSWORD=mot-de-passe-postgres
DB_HOST=127.0.0.1
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
